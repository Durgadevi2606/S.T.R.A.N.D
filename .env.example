# =============================================================
# S.T.R.A.N.D — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Register at: https://dataspace.copernicus.eu
CDSE_CLIENT_ID=your_copernicus_client_id
CDSE_CLIENT_SECRET=your_copernicus_client_secret
CDSE_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1

# --- Google Gemini (Copilot LLM) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro

# --- S.T.R.A.N.D API ---
STRAND_API_KEYS=["dev-key-change-in-production"]
STRAND_HOST=0.0.0.0
STRAND_PORT=8000

# --- Redis (Task Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Database ---
DATABASE_PATH=./data/strand.duckdb

# --- Data Directories ---
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
VECTOR_DATA_DIR=./data/vectors
TILES_DIR=./data/tiles
REPORTS_DIR=./data/reports

# --- ML Model ---
MODEL_CHECKPOINT_DIR=./ml/checkpoints

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/strand.log
